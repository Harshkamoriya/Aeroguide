# AeroGuide — Environment Configuration
# Copy this file to .env and adjust values as needed.
# All values shown are defaults — the app works without a .env file.

# ── Ollama (local LLM) ─────────────────────────────────────────────────────
# Start Ollama before running the server: ollama serve
# Pull the model once: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=db/airport.db

# ── API Server ─────────────────────────────────────────────────────────────
PORT=8000

# ── STT (local Whisper) ────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large
# Models are downloaded once to stt/models/ on first use.
WHISPER_MODEL=base

# ── TTS (pyttsx3 / OS voices) ─────────────────────────────────────────────
# Speech rate in words-per-minute (default 165)
PYTTSX3_RATE=165
# Partial voice name match — leave blank to auto-select English female voice
# Windows examples: Zira, Hazel, David
# macOS examples: Samantha, Alex
PYTTSX3_VOICE_NAME=

# ── Twilio (outbound departure-alert calls) ────────────────────────────────
# Create a free account at https://www.twilio.com/try-twilio
# Find SID + Token in: https://console.twilio.com  → Account Info
# TWILIO_FROM_NUMBER must be a verified Twilio number in E.164 format
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12015551234

# ── CLI client ─────────────────────────────────────────────────────────────
AEROGUIDE_URL=http://localhost:8000
